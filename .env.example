# ============================================================================
# Spotz POS — Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
# ============================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- M-Pesa (Till 5241121 — Buy Goods) ---
# Development: leave MPESA_MOCK_MODE=true — simulates STK push without Daraja.
# Production:  set MPESA_MOCK_MODE=false and fill in the values below.
MPESA_ENVIRONMENT=sandbox
MPESA_MOCK_MODE=true
MPESA_SHORTCODE=5241121
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_MOCK_DELAY_SECONDS=6
